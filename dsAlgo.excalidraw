      "seed": 1306255627,
      "version": 1793,
      "versionNonce": 258652877,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "[2,3,1,2,4,3],   k = 7;\n\nno sort()\n\n    1. [4,3]\n    2. [1,2,3]\n\nnot to care about:\n    1. the subarray\n    2. the order of subarray\n\nreq:\nint l, r = 0;\nint sum;\nint window_length\nint max_valid_window_length = max(max_valid_window_length, valid_window_length)\n\nfor( r : nums.size()){\n        window_length = r-l + 1;\n        sum += nums[r];\n        while(sum > k){\n                sum -= nums[l]\n                l++;\n            }\n    if(sum == k){\n                max_valid_window_length = max(max_valid_window_length, window_length);\n    }\n\nreturn max_valid_window_length;                \n\n",
      "fontSize": 24,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[2,3,1,2,4,3],   k = 7;\n\nno sort()\n\n    1. [4,3]\n    2. [1,2,3]\n\nnot to care about:\n    1. the subarray\n    2. the order of subarray\n\nreq:\nint l, r = 0;\nint sum;\nint window_length\nint max_valid_window_length = max(max_valid_window_length, valid_window_length)\n\nfor( r : nums.size()){\n        window_length = r-l + 1;\n        sum += nums[r];\n        while(sum > k){\n                sum -= nums[l]\n                l++;\n            }\n    if(sum == k){\n                max_valid_window_length = max(max_valid_window_length, window_length);\n    }\n\nreturn max_valid_window_length;                \n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
