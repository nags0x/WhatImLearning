    },
    {
      "id": "SX9fgIZXixzbjXACb9L6A",
      "type": "text",
      "x": -2143.383350228514,
      "y": 4891.931225025645,
      "width": 485.314697265625,
      "height": 181.25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 277510994,
      "version": 238,
      "versionNonce": 1328892045,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "l,r = 0,0\n\nmax_length = max( size_of_window )\n\n",
      "fontSize": 29,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "l,r = 0,0\n\nmax_length = max( size_of_window )\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rDgtznKKwsbbLJXa7nVDj",
      "type": "text",
      "x": -1495.4904548928325,
      "y": 5032.173908054771,
      "width": 583.7695922851562,
      "height": 471.25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 1641709778,
      "version": 753,
      "versionNonce": 1207348973,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "keep l at 0\nand r at 1 \nand increment the window\n i.e r while count < = k\nthen check max_freq(i.e window_size)\nwhen to stop r when count > k\nthen reset count and increment l\nupdate the window_size\ncompare to the max_window\n\n\nloop the above until when reach nums.size();\n",
      "fontSize": 29,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "keep l at 0\nand r at 1 \nand increment the window\n i.e r while count < = k\nthen check max_freq(i.e window_size)\nwhen to stop r when count > k\nthen reset count and increment l\nupdate the window_size\ncompare to the max_window\n\n\nloop the above until when reach nums.size();\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SiJu7X5qAIVh5IOGD7uIB",
