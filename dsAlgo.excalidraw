      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "[A,A,B,A,B,A], k =1\nl, r at 0\nint i = l;\nchar current = ' ';\nloop on r;\n       current = nums[r]\n    if(nums[i] == current){\n            count += 1;\n    }\nif(count > k){\n        l++;\n        count--;\n    }\ncurrent_window_size = r-l +1;\nmax_freq = max(max_freq, current_window_size);\n\nreturn max",
      "fontSize": 29,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[A,A,B,A,B,A], k =1\nl, r at 0\nint i = l;\nchar current = ' ';\nloop on r;\n       current = nums[r]\n    if(nums[i] == current){\n            count += 1;\n    }\nif(count > k){\n        l++;\n        count--;\n    }\ncurrent_window_size = r-l +1;\nmax_freq = max(max_freq, current_window_size);\n\nreturn max",
      "autoResize": true,
      "lineHeight": 1.25
    },
