      "text": "l,r, size_of_window, max_length = 0;",
      "fontSize": 29,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "l,r, size_of_window, max_length = 0;",
      "autoResize": true,
