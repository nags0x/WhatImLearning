      "link": null,
      "locked": false,
      "text": "int l, r = 0;\nint no_of_operations_left = ops;\nint size_of_window =0;\nint max_freq = 0;\nint difference = nums[r] - nums[l];\nint temp = 0;\nint temp_count = 0;\n\nsort(nums.begin(), nums.end());\n\nfor(int i = 0; i < nums.size(); i++){\n        \n       (no_of_operations_left <= 0) ? return 0;\n\n        r++;\n        size_of_window += 1;\n        while(l < r){\n            if((difference > k || difference < -k)){\n                l++;\n             } else{\n                if(difference >= 0) { nums[l] += difference }\n                else{ nums[r] -= difference }\n                no_of_operations_left -= 1;\n                temp = nums[r];\n                temp_count += 1;\n                max_freq = max(max_freq, temp_count);\n\n\n\n\n                ",
      "fontSize": 29,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int l, r = 0;\nint no_of_operations_left = ops;\nint size_of_window =0;\nint max_freq = 0;\nint difference = nums[r] - nums[l];\nint temp = 0;\nint temp_count = 0;\n\nsort(nums.begin(), nums.end());\n\nfor(int i = 0; i < nums.size(); i++){\n        \n       (no_of_operations_left <= 0) ? return 0;\n\n        r++;\n        size_of_window += 1;\n        while(l < r){\n            if((difference > k || difference < -k)){\n                l++;\n             } else{\n                if(difference >= 0) { nums[l] += difference }\n                else{ nums[r] -= difference }\n                no_of_operations_left -= 1;\n                temp = nums[r];\n                temp_count += 1;\n                max_freq = max(max_freq, temp_count);\n\n\n\n\n                ",
