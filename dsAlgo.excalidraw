      "seed": 420841771,
      "version": 232,
      "versionNonce": 494623405,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "1;\nsum = 2\n\n2;\nsum = 5;\n\n3;\nsum = 6;\n\n4; \nsum = 8\nwhlile act\n(8 > 7){\n    sum = 8 - 2 //6\n    l = 3;\n}\n\n",
      "fontSize": 24,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1;\nsum = 2\n\n2;\nsum = 5;\n\n3;\nsum = 6;\n\n4; \nsum = 8\nwhlile act\n(8 > 7){\n    sum = 8 - 2 //6\n    l = 3;\n}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nrWF1bC3ddN9v197tgTXI",
      "type": "text",
      "x": -3268.917658280884,
      "y": 9077.960317598441,
      "width": 265.4398498535156,
      "height": 660,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 1432003973,
      "version": 441,
      "versionNonce": 603290893,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1773169837244,
      "link": null,
      "locked": false,
      "text": "5;\nsum = 10\nwhile(10 > 7){\n    sum = 10 - 3; // 7\n      l = 1;\n}\nsum == 7{\n        window_length = 3;\n       }\n\n\n6;\nsum = 7 + 3;\nwhile(10 > 7){\n    sum -= 1; //9\n      l = 2;\n} // 9 > 7 sum -= 2 //7\n                l = 4;\n}\n\n\n",
      "fontSize": 24,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5;\nsum = 10\nwhile(10 > 7){\n    sum = 10 - 3; // 7\n      l = 1;\n}\nsum == 7{\n        window_length = 3;\n       }\n\n\n6;\nsum = 7 + 3;\nwhile(10 > 7){\n    sum -= 1; //9\n      l = 2;\n} // 9 > 7 sum -= 2 //7\n                l = 4;\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
