    {
      "id": "gtJfFodpxOvvaavFJAkV2",
      "type": "text",
      "x": -2874.0081510930254,
      "y": 6333.491351888751,
      "width": 648.7586059570312,
      "height": 616.25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
