    {
      "id": "WbjAZA-sVtP0mpRlJBCji",
      "type": "text",
      "x": -2935.3775430356495,
      "y": 7349.282917087855,
      "width": 951.887451171875,
      "height": 930,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
