    {
      "id": "87L4tms9br_Rlne7vPJle",
      "type": "text",
      "x": 1989.7222570585916,
      "y": 3081.243833964121,
      "width": 1124.531982421875,
      "height": 833.75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
